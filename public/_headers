/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Audit #5: cross-origin isolation headers. COOP same-origin is safe
  # (no cross-origin window.opener use; share links are plain
  # target=_blank anchors). COEP is credentialless, NOT require-corp:
  # require-corp would block the cross-origin loads this site needs
  # (Google Fonts, gtag, Frankfurter .dev, the AI worker, FormSubmit),
  # none of which send CORP headers. credentialless loads those without
  # credentials (none of them need cookies) and is ignored by browsers
  # that do not support it. CORP same-origin on our own assets only
  # blocks other origins hotlinking them; our pages load them same-origin.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Resource-Policy: same-origin
  # Fix #20: camera=(self) — the QR Code Scanner tool uses live camera
  # (navigator.mediaDevices.getUserMedia). camera=() made the browser reject
  # every camera request, so "Start Camera Scanner" always failed with
  # "permission denied". microphone/geolocation stay disabled (unused).
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-RXRK174DwYiwGZ/+Q3OF3LTd4NrvnOA+H1Zud65efXM=' 'sha256-R//SwGFvBQlfd/n/VKFqILpTzz2rmJhqHDbf0cgXoB8=' 'sha256-1u3VVGpwIWYs2AbgUz840x/84M8EsEyPtVIyO5C8FGQ=' https://www.google.com https://www.gstatic.com https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://www.google-analytics.com; connect-src 'self' https://utilityflow-ai-worker.bilalayyah.workers.dev https://formsubmit.co https://api.frankfurter.dev https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' https://formsubmit.co
  Cache-Control: public, max-age=3600, must-revalidate

