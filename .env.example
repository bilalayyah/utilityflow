# ==============================================================================
# Server-Side AI Secret (Required for AI Writing Assistant, Summarizer, Finder)
# Set via AI Studio Environment Variables / Secrets or `wrangler secret put`.
# NEVER commit real API keys.
# ==============================================================================

GROQ_API_KEY=""

# ==============================================================================
# Optional Configuration (All have safe same-origin defaults — safe to omit)
# ==============================================================================

# Optional: Comma-separated allowed CORS origins for standalone Worker deployments
# Leave empty during local dev or same-origin preview.
# AI_ALLOWED_ORIGINS=""

# Optional: Standalone Cloudflare Worker base URL when hosted on another origin
# Leave empty or "/" for same-origin /api/ai/* routing.
# VITE_AI_API_URL=""

# Optional: Canonical origin used for SEO meta tags & sitemap builds (defaults to https://utilityflow.online)
# VITE_SITE_URL="https://utilityflow.online"
